# Port number
Port= "Port number for server"

# MongoDB connection string
MONGODB_URI= "mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/your-database-name"

# Cloudinary connection
CLOUDINARY_API_KEY= "your_cloudinary_api_key"
CLOUDINARY_SECRET_KEY= "your_cloudinary_secret_key"
CLOUDINARY_NAME= "your_cloudinary_name"

# JWT secret key
JWT_SECRET= "your_jwt_secret_here"

# Frontend url for cors
ADMIN_URL= "admin_panel_url"
FRONTEND_URL="store_frontend_url"

# Cashfree payment gateway setup
CASHFREE_CLIENT_ID= "your_cashfree_app_id"
CASHFREE_CLIENT_SECRET= "your_cashfree_secret_key"
CASHFREE_ENV= "cashfree_environment"